---
import { getCollection } from 'astro:content';
const matches = await getCollection('matches');
// 按日期从新到旧排序
matches.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>北岸联足球俱乐部 | 官方战报</title>
  <style>
    :root {
      --navy: #071426; --navy-2: #0b1e36; --card: #0e2440;
      --text: #eef4fb; --muted: #8ea4bd;
      --gold: #e7c65a; --gold-2: #c9a63c;
      --line: rgba(255,255,255,.10); --max: 1200px;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, sans-serif; background: var(--navy); color: var(--text); line-height: 1.6; }
    a { color: inherit; text-decoration: none; }
    .container { width: min(var(--max), calc(100% - 40px)); margin: 0 auto; }

    /* 顶部导航 */
    .site-header { position: sticky; top: 0; z-index: 60; background: rgba(7,20,38,.88); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
    .nav { height: 76px; display: flex; align-items: center; justify-content: space-between; }
    .brand { display: flex; align-items: center; gap: 12px; }
    .crest { width: 44px; height: 50px; background: linear-gradient(160deg, #f3df8e, var(--gold-2)); clip-path: polygon(50% 0, 100% 14%, 100% 64%, 50% 100%, 0 64%, 0 14%); display: grid; place-items: center; color: #071426; font-weight: 900; font-size: 19px; }
    .brand-text strong { font-size: 18px; display: block; }
    .brand-text small { font-size: 10px; letter-spacing: .22em; color: var(--muted); font-weight: 700; }
    .nav-links { display: flex; gap: 30px; font-size: 15px; font-weight: 600; color: var(--muted); }
    .nav-links a:hover { color: var(--text); }
    .btn-gold { background: linear-gradient(135deg, #f3df8e, var(--gold)); color: #071426; font-weight: 800; padding: 11px 20px; border-radius: 10px; border: 0; cursor: pointer; }

    /* 滚动快讯 */
    .ticker { background: linear-gradient(90deg, var(--gold-2), var(--gold)); color: #071426; overflow: hidden; white-space: nowrap; font-weight: 800; font-size: 13px; }
    .ticker-inner { display: inline-flex; gap: 16px; padding: 8px 0; animation: ticker 30s linear infinite; }
    .ticker-tag { background: #071426; color: var(--gold); padding: 2px 10px; border-radius: 4px; font-size: 11px; margin-left: 20px; }
    @keyframes ticker { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* Hero 区域 */
    .hero { position: relative; padding: 70px 0 52px; }
    .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: center; }
    .eyebrow { color: var(--gold); font-size: 12px; font-weight: 800; letter-spacing: .18em; margin-bottom: 16px; }
    h1 { margin: 0 0 18px; font-size: clamp(40px, 5.6vw, 66px); line-height: 1.03; letter-spacing: -.045em; font-weight: 900; }
    h1 em { font-style: normal; color: var(--gold); }
    .hero-copy { color: var(--muted); font-size: 17px; max-width: 520px; margin: 0 0 26px; }
    .hero-stats { display: flex; gap: 38px; margin-top: 34px; padding-top: 26px; border-top: 1px solid var(--line); }
    .stat b { display: block; font-size: 26px; color: var(--gold); }
    .stat span { font-size: 12px; color: var(--muted); }

    /* 下载卡片 */
    .download-card { background: linear-gradient(180deg, rgba(16,42,74,.92), rgba(9,26,48,.96)); border: 1px solid rgba(231,198,90,.24); border-radius: 22px; padding: 24px; box-shadow: 0 30px 70px rgba(0,0,0,.45); }
    .dl-badge { background: rgba(231,198,90,.14); color: var(--gold); border: 1px solid rgba(231,198,90,.32); font-size: 11px; font-weight: 800; padding: 5px 10px; border-radius: 999px; margin-bottom: 12px; display: inline-block;}
    .download-card h3 { margin: 0 0 6px; font-size: 20px; }
    .download-card > p { margin: 0 0 18px; color: var(--muted); font-size: 13.5px; }
    .download-stack { display: flex; flex-direction: column; gap: 10px; }
    .dl-btn { display: flex; align-items: center; gap: 13px; padding: 11px 14px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.10); border-radius: 12px; transition: .2s ease; }
    .dl-btn:hover { background: rgba(231,198,90,.10); border-color: rgba(231,198,90,.5); transform: translateX(4px); }
    .dl-text small { display: block; font-size: 10px; color: var(--muted); text-transform: uppercase; }
    .dl-text strong { font-size: 15px; }

    /* 实时比分板 (前端 JS 控制) */
    .live-scoreboard { margin-top: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .live-card { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 20px; }
    .live-league { font-size: 12px; color: var(--gold); font-weight: bold; margin-bottom: 12px; display: flex; justify-content: space-between; }
    .live-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 16px; font-weight: bold; }
    .live-score { color: var(--gold); font-size: 20px; }
    .live-status { font-size: 11px; background: rgba(231,198,90,.2); padding: 2px 6px; border-radius: 4px; color: var(--gold); }

    /* 战报列表区 */
    .section-head { margin: 60px 0 24px; border-bottom: 1px solid #1a365d; padding-bottom: 10px; display: flex; justify-content: space-between; align-items: flex-end; }
    .section-head h2 { margin: 0; color: var(--gold); font-size: 24px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .card { background: var(--card); border: 1px solid #1a365d; border-radius: 12px; padding: 24px; transition: 0.3s; display: flex; flex-direction: column; }
    .card:hover { transform: translateY(-5px); border-color: var(--gold); }
    .card-league { font-size: 12px; color: var(--gold); font-weight: bold; margin-bottom: 10px; }
    .card-title { font-size: 20px; margin: 0 0 15px 0; line-height: 1.4; }
    .card-score { font-size: 24px; font-weight: 900; color: var(--gold); background: rgba(0,0,0,0.3); padding: 10px; border-radius: 8px; text-align: center; margin-top: auto; }

    @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .nav-links { display: none; } }
  </style>
</head>
<body>
  <!-- 顶部导航 -->
  <header class="site-header">
    <div class="container nav">
      <a href="/" class="brand">
        <span class="crest">N</span>
        <span class="brand-text"><strong>北岸联</strong><small>NORTHSHORE FC</small></span>
      </a>
      <nav class="nav-links">
        <a href="#live">实时比分</a>
        <a href="#news">最新战报</a>
        <a href="#">关于我们</a>
      </nav>
      <a class="btn-gold" href="#download">下载 App</a>
    </div>
  </header>

  <!-- 滚动快讯 -->
  <div class="ticker">
    <div class="ticker-inner">
      <span class="ticker-tag">快讯</span>
      <span>北岸联官方战报系统正式上线！</span><span>·</span>
      <span>AI 自动追踪全球足篮赛事，秒级生成专业报道</span><span>·</span>
      <span>北岸联官方战报系统正式上线！</span><span>·</span>
      <span>AI 自动追踪全球足篮赛事，秒级生成专业报道</span>
    </div>
  </div>

  <!-- 主视觉 -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="eyebrow">为北岸而战 · SINCE 1958</div>
        <h1>荣耀不是过去，<br><em>是下一场比赛。</em></h1>
        <p class="hero-copy">跟随北岸联的每一脚传球。赛事直播、战术复盘、球员专访与票务会员，尽在官方 App。</p>
        <div class="hero-stats">
          <div class="stat"><b>12</b><span>联赛冠军</span></div>
          <div class="stat"><b>78%</b><span>本赛季胜率</span></div>
          <div class="stat"><b>18</b><span>主场不败</span></div>
        </div>
      </div>

      <!-- 下载卡片（4个按钮） -->
      <aside class="download-card" id="download">
        <span class="dl-badge">官方 App</span>
        <h3>下载北岸联官方 App</h3>
        <p>直播、票务、会员权益，一手掌握。</p>
        <div class="download-stack">
          <a href="#" class="dl-btn">
            <div class="dl-text"><small>Download on</small><strong>App Store</strong></div>
          </a>
          <a href="#" class="dl-btn">
            <div class="dl-text"><small>Get it on</small><strong>Google Play</strong></div>
          </a>
          <a href="#" class="dl-btn">
            <div class="dl-text"><small>下载于</small><strong>华为应用市场</strong></div>
          </a>
          <a href="#" class="dl-btn">
            <div class="dl-text"><small>下载于</small><strong>应用宝</strong></div>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <!-- 实时比分板 -->
  <section class="container" id="live">
    <div class="section-head">
      <h2>⚡ 实时赛事</h2>
      <span style="font-size: 12px; color: var(--muted);">每 60 秒自动刷新</span>
    </div>
    <div class="live-scoreboard" id="liveScoreContainer">
      <p style="color: var(--muted);">正在拉取最新赛事数据...</p>
    </div>
  </section>

  <!-- 战报列表 -->
  <section class="container" id="news">
    <div class="section-head">
      <h2>最新战报</h2>
    </div>
    <div class="grid">
      {matches.map(m => (
        <a href={`/match/${m.slug}/`} class="card">
          <div class="card-league">{m.data.sport || '体育'} · {m.data.league || '赛事'}</div>
          <h2 class="card-title">{m.data.title}</h2>
          <div class="card-score">
            {m.data.home} {m.data.homeScore} - {m.data.awayScore} {m.data.away}
          </div>
        </a>
      ))}
      {matches.length === 0 && <p>暂无战报，等待机器人更新...</p>}
    </div>
  </section>

  <!-- 前端实时数据拉取脚本 -->
  <script>
    // 这个脚本会在浏览器里运行，每 60 秒去拉取一次最新的数据
    async function fetchLiveScores() {
      const container = document.getElementById('liveScoreContainer');
      try {
        // 使用 TheSportsDB 免费接口获取英超和 NBA 最新赛程
        const res = await fetch('https://www.thesportsdb.com/api/v1/json/123/eventsnextleague.php?id=4328'); // 英超下一场
        const nbaRes = await fetch('https://www.thesportsdb.com/api/v1/json/123/eventsnextleague.php?id=4387'); // NBA 下一场
        
        const data = await res.json();
        const nbaData = await nbaRes.json();
        
        let html = '';
        
        // 渲染英超
        if (data.events && data.events.length > 0) {
          const e = data.events[0];
          html += `
            <div class="live-card">
              <div class="live-league"><span>${e.strLeague}</span><span class="live-status">即将开始</span></div>
              <div class="live-row"><span>${e.strHomeTeam}</span><span class="live-score">VS</span><span>${e.strAwayTeam}</span></div>
              <div style="text-align:center; font-size:12px; color:var(--muted); margin-top:8px;">${e.dateEvent} ${e.strTime}</div>
            </div>
          `;
        }
        
        // 渲染 NBA
        if (nbaData.events && nbaData.events.length > 0) {
          const e = nbaData.events[0];
          html += `
            <div class="live-card">
              <div class="live-league"><span>${e.strLeague}</span><span class="live-status">即将开始</span></div>
              <div class="live-row"><span>${e.strHomeTeam}</span><span class="live-score">VS</span><span>${e.strAwayTeam}</span></div>
              <div style="text-align:center; font-size:12px; color:var(--muted); margin-top:8px;">${e.dateEvent} ${e.strTime}</div>
            </div>
          `;
        }

        if (html === '') {
          html = '<p style="color: var(--muted);">近期暂无赛事排期。</p>';
        }
        
        container.innerHTML = html;
      } catch (error) {
        console.error("拉取实时数据失败:", error);
      }
    }

    // 页面加载时拉取一次
    fetchLiveScores();
    // 设定每 60 秒（60000毫秒）自动刷新一次
    setInterval(fetchLiveScores, 60000);
  </script>
</body>
</html>
