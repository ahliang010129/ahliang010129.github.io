---
import { getCollection } from 'astro:content';
const matches = await getCollection('matches');
// 按日期从新到旧排序
matches.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>北岸联足球俱乐部 | 官方战报</title>
  <style>
    :root { --bg: #071426; --card: #0e2440; --gold: #e7c65a; --text: #fff; --muted: #8ea4bd; }
    body { margin: 0; font-family: -apple-system, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
    .container { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }
    .header { text-align: center; margin-bottom: 50px; border-bottom: 1px solid #1a365d; padding-bottom: 20px; }
    .header h1 { color: var(--gold); font-size: 36px; letter-spacing: 2px; margin: 0; text-transform: uppercase; }
    .header p { color: var(--muted); font-size: 14px; margin-top: 10px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .card { background: var(--card); border: 1px solid #1a365d; border-radius: 12px; padding: 24px; transition: 0.3s; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
    .card:hover { transform: translateY(-5px); border-color: var(--gold); box-shadow: 0 10px 30px rgba(231,198,90,0.15); }
    .card-league { font-size: 12px; color: var(--gold); font-weight: bold; letter-spacing: 1px; margin-bottom: 10px; }
    .card-title { font-size: 20px; margin: 0 0 15px 0; line-height: 1.4; }
    .card-score { font-size: 24px; font-weight: 900; color: var(--gold); background: rgba(0,0,0,0.3); padding: 10px; border-radius: 8px; text-align: center; margin-top: auto; }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <h1>Match Reports</h1>
      <p>最新 AI 自动化赛事战报</p>
    </header>

    <div class="grid">
      {matches.map(m => (
        <a href={`/match/${m.slug}/`} class="card">
          <div class="card-league">{m.data.league || '未知联赛'}</div>
          <h2 class="card-title">{m.data.title}</h2>
          <div class="card-score">
            {m.data.home} {m.data.homeScore} - {m.data.awayScore} {m.data.away}
          </div>
        </a>
      ))}
      {matches.length === 0 && <p>暂无战报，等待机器人更新...</p>}
    </div>
  </div>
</body>
</html>
