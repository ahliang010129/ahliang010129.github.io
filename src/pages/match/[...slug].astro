---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const matches = await getCollection('matches');
  return matches.map(m => ({
    params: { slug: m.slug },
    props: { match: m }
  }));
}

const { match } = Astro.props;
const { data, body } = match;

// 兼容 Pages CMS 的正文读取逻辑：如果在 frontmatter 的 body 里，就用 body；否则用默认的 Markdown body
const contentHtml = data.body || body;
---
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{data.title}</title>
  <style>
    :root { --bg: #071426; --card: #0e2440; --gold: #e7c65a; --text: #eef4fb; --muted: #8ea4bd; }
    body { margin: 0; font-family: -apple-system, sans-serif; background: var(--bg); color: var(--text); line-height: 1.8; }
    .container { max-width: 800px; margin: 0 auto; padding: 40px 20px; }
    .back-link { display: inline-block; color: var(--gold); text-decoration: none; margin-bottom: 30px; font-size: 14px; font-weight: bold; }
    .back-link:hover { text-decoration: underline; }
    .article-header { background: var(--card); border: 1px solid #1a365d; border-radius: 16px; padding: 40px; text-align: center; margin-bottom: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
    
    /* 新增：详情页大图样式 */
    .hero-image { width: 100%; border-radius: 12px; margin-bottom: 24px; object-fit: cover; max-height: 400px; }
    
    .league-tag { color: var(--muted); font-size: 12px; letter-spacing: 2px; text-transform: uppercase; }
    h1 { color: #fff; font-size: 32px; margin: 15px 0 30px 0; line-height: 1.3; }
    .scoreboard { display: flex; align-items: center; justify-content: center; gap: 20px; font-size: 28px; font-weight: 900; color: var(--gold); }
    .team { flex: 1; text-align: right; color: var(--text); }
    .team.away { text-align: left; }
    .score { background: rgba(231,198,90,0.1); padding: 10px 20px; border-radius: 12px; border: 1px solid var(--gold); white-space: nowrap; }
    .content { font-size: 18px; line-height: 1.9; color: #d1d5db; }
    .content p { margin-bottom: 24px; }
    .content h2, .content h3 { color: var(--gold); margin-top: 40px; }
    .content img { max-width: 100%; border-radius: 8px; margin: 20px 0; }
  </style>
</head>
<body>
  <div class="container">
    <a href="/" class="back-link">← 返回首页</a>
    
    <header class="article-header">
      {/* 关键修改：详情页大图渲染 */}
      {data.image && <img src={data.image} alt={data.title} class="hero-image" />}
      
      <div class="league-tag">{data.league || '赛事战报'} · {data.date.toLocaleDateString('zh-CN')}</div>
      <h1>{data.title}</h1>
      
      <div class="scoreboard">
        <div class="team">{data.home}</div>
        <div class="score">{data.homeScore} - {data.awayScore}</div>
        <div class="team away">{data.away}</div>
      </div>
    </header>

    <article class="content">
      {/* 渲染最终读取到的正文内容 */}
      <div set:html={contentHtml} />
    </article>
  </div>
</body>
</html>
